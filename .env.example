# ── Session ──────────────────────────────────────────
SESSION_SECRET=change-me-in-production

# ── Admin (optionnel — valeurs par défaut : admin@nd-tronchaye.fr / admin123) ──
# ADMIN_EMAIL=admin@nd-tronchaye.fr
# ADMIN_PASSWORD_HASH=<bcrypt hash>

# ── SMTP — Notification email des messages de contact ──
# Si ces variables ne sont pas renseignées, les messages seront
# uniquement stockés en base (pas d'envoi d'email).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=votre-email@example.com
SMTP_PASS=votre-mot-de-passe
NOTIFY_EMAIL=recteur@nd-tronchaye.fr
